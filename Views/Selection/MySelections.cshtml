
@model RealEstateAgency.ViewModels.MySelectionsViewModel

@using RealEstateAgency.Models.Enums

@{
    ViewData["Title"] = "Подобранная недвижимость";
}

<div class="container py-5">
    <h1 class="mb-2">Подобранная недвижимость</h1>

    <p class="text-muted mb-4">
        Здесь находятся объекты, которые риелтор подобрал по вашим заявкам.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Requests.Count == 0)
    {
        <div class="alert alert-info">
            У вас пока нет заявок.
            Создайте заявку, чтобы риелтор мог подобрать для вас недвижимость.
        </div>
    }
    else
    {
        @foreach (var request in Model.Requests)
        {
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div>
                        <h4>Подбор по заявке №@request.RequestId</h4>
                        <p class="text-muted mb-0">
                            Тип сделки: @request.DealType.GetDisplayName()
                            ·
                            Дата: @request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
                        </p>
                    </div>

                    <span class="badge bg-primary">
                        @request.RequestStatus.GetDisplayName()
                    </span>
                </div>

                @if (request.Properties.Count == 0)
                {
                    <div class="alert alert-info">
                        Риелтор пока не добавил объекты в этот подбор.
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var property in request.Properties)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 shadow-sm">
                                    @if (!string.IsNullOrWhiteSpace(property.MainPhotoPath))
                                    {
                                        <img src="@property.MainPhotoPath"
                                             class="card-img-top"
                                             alt="Фотография объекта"
                                             style="height: 220px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center justify-content-center"
                                             style="height: 220px;">
                                            <span class="text-muted">
                                                Фотография отсутствует
                                            </span>
                                        </div>
                                    }

                                    <div class="card-body d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <h5>@property.Type.GetDisplayName()</h5>

                                            @if (property.IsViewed)
                                            {
                                                <span class="badge bg-success">
                                                    Просмотрен
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    Новый
                                                </span>
                                            }
                                        </div>

                                        <p class="text-muted">
                                            @property.Address
                                        </p>

                                        <p class="mb-1">
                                            Район: @property.District
                                        </p>

                                        <p class="mb-1">
                                            Площадь: @property.Area м²
                                        </p>

                                        @if (property.RoomCount.HasValue)
                                        {
                                            <p class="mb-1">
                                                Комнат: @property.RoomCount
                                            </p>
                                        }

                                        <p class="mb-1">
                                            Статус объекта:
                                            @property.Status.GetDisplayName()
                                        </p>

                                        <h4 class="mt-auto mb-3">
                                            @property.Price.ToString("N0") ₽
                                        </h4>

                                        <a asp-controller="Properties"
                                           asp-action="Details"
                                           asp-route-id="@property.PropertyId"
                                           class="btn btn-outline-primary mb-3">
                                            Подробнее об объекте
                                        </a>

                                        <form asp-action="UpdateFeedback"
                                              method="post">

                                            <input type="hidden"
                                                   name="selectionId"
                                                   value="@property.SelectionId" />

                                            <label class="form-label">
                                                Ваш комментарий
                                            </label>

                                            <textarea name="comment"
                                                      class="form-control mb-2"
                                                      rows="3"
                                                      maxlength="1000"
                                                      placeholder="Например, хочу посмотреть этот объект">@property.ClientComment</textarea>

                                            <button type="submit"
                                                    class="btn btn-primary w-100">
                                                Сохранить отзыв и отметить просмотр
                                            </button>
                                        </form>

                                        <small class="text-muted mt-2">
                                            Добавлен:
                                            @property.AddedAt.ToLocalTime().ToString("dd.MM.yyyy")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>
