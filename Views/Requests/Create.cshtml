
@model RealEstateAgency.ViewModels.RequestCreateViewModel

@using RealEstateAgency.Models.Enums

@{
    ViewData["Title"] = "Новая заявка";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="mb-2">Создание заявки</h1>
            <p class="text-muted mb-4">
                Расскажите, какую недвижимость вы хотите найти.
            </p>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="DealType" class="form-label"></label>
                            <select asp-for="DealType"
                                    asp-items="Html.GetEnumSelectList<DealType>()"
                                    class="form-select">
                                <option value="">Выберите тип сделки</option>
                            </select>
                            <span asp-validation-for="DealType"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PropertyType" class="form-label"></label>
                            <select asp-for="PropertyType"
                                    asp-items="Html.GetEnumSelectList<PropertyType>()"
                                    class="form-select">
                                <option value="">Любой тип недвижимости</option>
                            </select>
                            <span asp-validation-for="PropertyType"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PreferredDistrict"
                                   class="form-label"></label>
                            <input asp-for="PreferredDistrict"
                                   class="form-control"
                                   placeholder="Например, Ленинский район" />
                            <span asp-validation-for="PreferredDistrict"
                                  class="text-danger"></span>
                        </div>

                        <h5 class="mt-4 mb-3">Бюджет</h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="MinPrice" class="form-label"></label>
                                <input asp-for="MinPrice"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control" />
                                <span asp-validation-for="MinPrice"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaxPrice" class="form-label"></label>
                                <input asp-for="MaxPrice"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control" />
                                <span asp-validation-for="MaxPrice"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <h5 class="mt-4 mb-3">Параметры недвижимости</h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="MinArea" class="form-label"></label>
                                <input asp-for="MinArea"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control" />
                                <span asp-validation-for="MinArea"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaxArea" class="form-label"></label>
                                <input asp-for="MaxArea"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       class="form-control" />
                                <span asp-validation-for="MaxArea"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="RoomCount" class="form-label"></label>
                                <input asp-for="RoomCount"
                                       type="number"
                                       min="0"
                                       class="form-control" />
                                <span asp-validation-for="RoomCount"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mt-4 mb-4">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Дополнительные пожелания к недвижимости"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                Отправить заявку
                            </button>

                            <a asp-action="MyRequests"
                               class="btn btn-outline-secondary">
                                Мои заявки
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
