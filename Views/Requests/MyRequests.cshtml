
@model RealEstateAgency.ViewModels.RequestListViewModel

@using RealEstateAgency.Models.Enums

@{
    ViewData["Title"] = "Мои заявки";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1>Мои заявки</h1>
            <p class="text-muted mb-0">
                Здесь отображаются ваши обращения в агентство.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Selections"
               asp-action="MySelections"
               class="btn btn-outline-primary">
                Подобранная недвижимость
            </a>

            <a asp-action="Create" class="btn btn-primary">
                Создать заявку
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (Model.Requests.Count == 0)
    {
        <div class="alert alert-info">
            У вас пока нет заявок. Создайте первую заявку, чтобы начать подбор недвижимости.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var request in Model.Requests)
            {
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                <div>
                                    <h5>Заявка №@request.Id</h5>
                                    <span class="text-muted">
                                        Создана: @request.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </span>
                                </div>

                                <span class="badge bg-primary">
                                    @request.Status.GetDisplayName()
                                </span>
                            </div>

                            <hr />

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <strong>Тип сделки:</strong>
                                    <p>@request.DealType.GetDisplayName()</p>
                                </div>

                                <div class="col-md-4">
                                    <strong>Тип недвижимости:</strong>
                                    <p>
                                        @(request.PropertyType.HasValue
                                            ? request.PropertyType.Value.GetDisplayName()
                                            : "Любой")
                                    </p>
                                </div>

                                <div class="col-md-4">
                                    <strong>Желаемый район:</strong>
                                    <p>@(request.PreferredDistrict ?? "Не указан")</p>
                                </div>

                                <div class="col-md-4">
                                    <strong>Бюджет:</strong>
                                    <p>
                                        @(request.MinPrice?.ToString("N0") ?? "Не указан")
                                        —
                                        @(request.MaxPrice?.ToString("N0") ?? "Не указан") ₽
                                    </p>
                                </div>

                                <div class="col-md-4">
                                    <strong>Площадь:</strong>
                                    <p>
                                        @(request.MinArea?.ToString("N2") ?? "Не указана")
                                        —
                                        @(request.MaxArea?.ToString("N2") ?? "Не указана") м²
                                    </p>
                                </div>

                                <div class="col-md-4">
                                    <strong>Количество комнат:</strong>
                                    <p>@(request.RoomCount?.ToString() ?? "Не указано")</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(request.Description))
                            {
                                <div class="mb-3">
                                    <strong>Дополнительные пожелания:</strong>
                                    <p class="mb-0">@request.Description</p>
                                </div>
                            }

                            <hr />

                            <div>
                                <strong>Ответственный риелтор:</strong>

                                @if (!string.IsNullOrWhiteSpace(request.RealtorName))
                                {
                                    <span>@request.RealtorName</span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Пока не назначен
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
