
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ДомПрофи</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="main-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon">Д</span>
                <span>ДомПрофи</span>
            </a>

            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">Главная</a>
                <a href="#catalog">Каталог</a>
                <a href="#about">О компании</a>
                <a href="#contacts">Контакты</a>
            </nav>

            <a class="header-login" href="#login">Войти</a>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="main-footer" id="contacts">
        <div class="container footer-inner">
            <div>
                <a class="brand footer-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">Д</span>
                    <span>ДомПрофи</span>
                </a>
                <p>Помогаем найти место, которое станет домом.</p>
            </div>

            <div class="footer-copy">
                © @DateTime.Now.Year ДомПрофи. Учебный проект.
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
