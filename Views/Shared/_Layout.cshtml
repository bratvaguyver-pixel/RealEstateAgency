@using Microsoft.AspNetCore.Identity
@using RealEstateAgency.Models
@inject UserManager<ApplicationUser> UserManager

@{
    ApplicationUser? currentUser = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        currentUser = await UserManager.GetUserAsync(User);
    }

    string profileName = currentUser == null
        ? "Личный кабинет"
        : $"{currentUser.FirstName} {currentUser.LastName}".Trim();

    if (string.IsNullOrWhiteSpace(profileName))
    {
        profileName = "Профиль пользователя";
    }

    string roleName = "Пользователь";
    string dashboardAction = "Index";
    string dashboardController = "Home";

    if (User.IsInRole(UserRoles.Admin))
    {
        roleName = "Администратор";
        dashboardAction = "Admin";
        dashboardController = "Dashboard";
    }
    else if (User.IsInRole(UserRoles.Realtor))
    {
        roleName = "Риелтор";
        dashboardAction = "Realtor";
        dashboardController = "Dashboard";
    }
    else if (User.IsInRole(UserRoles.Client))
    {
        roleName = "Клиент";
        dashboardAction = "Client";
        dashboardController = "Dashboard";
    }
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ДомПрофи</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-xl">
            <div class="container">
                <a class="navbar-brand site-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-symbol">Д</span>

                    <span class="brand-content">
                        <strong>ДомПрофи</strong>
                        <small>АГЕНТСТВО НЕДВИЖИМОСТИ</small>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Открыть меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav main-navigation me-auto">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Главная
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Properties"
                               asp-action="Index">
                                Каталог недвижимости
                            </a>
                        </li>

                        @if (User.IsInRole(UserRoles.Client))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Requests"
                                   asp-action="Create">
                                    Оставить заявку
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Мои разделы
                                </a>

                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Requests"
                                           asp-action="MyRequests">
                                            Мои заявки
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Selections"
                                           asp-action="MySelections">
                                            Мои подборы
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Contracts"
                                           asp-action="MyContracts">
                                            Мои договоры
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole(UserRoles.Realtor))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Properties"
                                   asp-action="Create">
                                    Добавить объект
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Рабочий раздел
                                </a>

                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Requests"
                                           asp-action="Assigned">
                                            Заявки клиентов
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Selections"
                                           asp-action="Create">
                                            Создать подбор
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Selections"
                                           asp-action="RealtorSelections">
                                            Созданные подборы
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Contracts"
                                           asp-action="RealtorIndex">
                                            Договоры
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole(UserRoles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Properties">
                                    Модерация
                                </a>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Управление
                                </a>

                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Admin"
                                           asp-action="Users">
                                            Пользователи
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Admin"
                                           asp-action="Properties">
                                            Объекты недвижимости
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Admin"
                                           asp-action="Requests">
                                            Заявки
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Admin"
                                           asp-action="Contracts">
                                            Договоры
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="header-account">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="user-profile"
                               asp-controller="@dashboardController"
                               asp-action="@dashboardAction"
                               title="Перейти в личный кабинет">

                                <span class="user-avatar">
                                    @(currentUser?.FirstName?.FirstOrDefault() ?? 'П')
                                </span>

                                <span class="user-profile-info">
                                    <strong>@profileName</strong>
                                    <small>@roleName</small>
                                </span>
                            </a>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="logout-form">

                                <button type="submit"
                                        class="btn btn-outline-danger logout-button">
                                    Выйти
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary"
                               asp-controller="Account"
                               asp-action="Login">
                                Войти
                            </a>

                            <a class="btn btn-primary"
                               asp-controller="Account"
                               asp-action="Register">
                                Регистрация
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <div class="footer-logo">
                        <span class="brand-symbol">Д</span>
                        <strong>ДомПрофи</strong>
                    </div>

                    <p>
                        Помогаем найти недвижимость,
                        в которой начинается новая история.
                    </p>
                </div>

                <div class="footer-navigation">
                    <a asp-controller="Home"
                       asp-action="Index">
                        Главная
                    </a>

                    <a asp-controller="Properties"
                       asp-action="Index">
                        Каталог
                    </a>

                    @if (User.IsInRole(UserRoles.Client))
                    {
                        <a asp-controller="Requests"
                           asp-action="Create">
                            Оставить заявку
                        </a>
                    }
                    else if (User.IsInRole(UserRoles.Realtor))
                    {
                        <a asp-controller="Properties"
                           asp-action="Create">
                            Добавить объект
                        </a>
                    }
                    else if (User.IsInRole(UserRoles.Admin))
                    {
                        <a asp-controller="Dashboard"
                           asp-action="Admin">
                            Панель администратора
                        </a>
                    }
                </div>
            </div>

            <div class="footer-bottom">
                <span>© @DateTime.Now.Year ДомПрофи</span>
                <span>Агентство недвижимости</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>