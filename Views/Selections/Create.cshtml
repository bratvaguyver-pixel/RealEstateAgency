@model RealEstateAgency.ViewModels.SelectionCreateViewModel

@{
    ViewData["Title"] = "Создание подбора";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h2 class="mb-4">Создание подбора недвижимости</h2>

            <p class="text-muted">
                Выберите заявку клиента и объект недвижимости,
                который хотите предложить.
            </p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-warning">
                    @TempData["Error"]
                </div>
            }

            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="RequestId" class="form-label"></label>

                    <select asp-for="RequestId"
                            asp-items="Model.Requests"
                            class="form-select">
                        <option value="0">Выберите заявку</option>
                    </select>

                    <span asp-validation-for="RequestId"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="PropertyId" class="form-label"></label>

                    <select asp-for="PropertyId"
                            asp-items="Model.Properties"
                            class="form-select">
                        <option value="0">Выберите объект</option>
                    </select>

                    <span asp-validation-for="PropertyId"
                          class="text-danger"></span>
                </div>

                @if (Model.Properties.Count == 0)
                {
                    <div class="alert alert-info">
                        Нет доступных объектов для выбранной заявки.
                        Добавьте подходящую недвижимость в каталог.
                    </div>
                }

                <button type="submit"
                        class="btn btn-primary"
                        disabled="@(Model.Requests.Count == 0 || Model.Properties.Count == 0)">
                    Добавить в подбор
                </button>

                <a asp-action="RealtorSelections"
                   class="btn btn-outline-secondary ms-2">
                    К созданным подборам
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}