
@model RealEstateAgency.ViewModels.SelectionCreateViewModel

@{
    ViewData["Title"] = "Создание подбора";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h2 class="mb-4">Создание подбора недвижимости</h2>

            <p class="text-muted">
                Выберите заявку клиента и подходящий объект недвижимости.
                Список объектов автоматически ограничивается типом недвижимости,
                указанным в заявке.
            </p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-warning">
                    @TempData["Error"]
                </div>
            }

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <form asp-controller="Selections"
                  asp-action="Create"
                  method="post">

                <div class="mb-3">
                    <label asp-for="RequestId" class="form-label"></label>

                    <select asp-for="RequestId"
                            asp-items="Model.Requests"
                            class="form-select">
                        <option value="0">Выберите заявку</option>
                    </select>

                    <span asp-validation-for="RequestId"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="PropertyId" class="form-label"></label>

                    <select asp-for="PropertyId"
                            asp-items="Model.Properties"
                            class="form-select">
                        <option value="0">Выберите объект</option>
                    </select>

                    <span asp-validation-for="PropertyId"
                          class="text-danger"></span>

                    @if (Model.RequestId > 0 && Model.Properties.Count == 0)
                    {
                        <div class="alert alert-info mt-2">
                            Для выбранной заявки пока нет доступных объектов
                            подходящего типа. Добавьте подходящий объект
                            недвижимости или выберите другую заявку.
                        </div>
                    }
                </div>

                <button type="submit"
                        class="btn btn-primary"
                        disabled="@(Model.Requests.Count == 0 || Model.Properties.Count == 0)">
                    Добавить в подбор
                </button>

                <a asp-controller="Requests"
                   asp-action="Assigned"
                   class="btn btn-outline-secondary ms-2">
                    К заявкам
                </a>

                <a asp-controller="Selections"
                   asp-action="RealtorSelections"
                   class="btn btn-outline-secondary mt-2 mt-sm-0">
                    К созданным подборам
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
