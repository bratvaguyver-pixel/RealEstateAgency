
@model RealEstateAgency.ViewModels.PropertySelectionViewModel

@using RealEstateAgency.Models.Enums

@{
    ViewData["Title"] = "Подбор недвижимости";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1>Подбор недвижимости</h1>
            <p class="text-muted mb-0">
                Заявка №@Model.RequestId · Клиент: @Model.ClientName
            </p>
        </div>

        <a asp-controller="Requests"
           asp-action="Assigned"
           class="btn btn-outline-secondary">
            Вернуться к заявкам
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="mb-3">Требования клиента</h5>

            <div class="row g-3">
                <div class="col-md-4">
                    <strong>Тип сделки:</strong>
                    <p>@Model.DealType.GetDisplayName()</p>
                </div>

                <div class="col-md-4">
                    <strong>Тип недвижимости:</strong>
                    <p>
                        @(Model.PropertyType.HasValue
                            ? Model.PropertyType.Value.GetDisplayName()
                            : "Любой")
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Район:</strong>
                    <p>@(Model.PreferredDistrict ?? "Любой")</p>
                </div>

                <div class="col-md-4">
                    <strong>Бюджет:</strong>
                    <p>
                        @(Model.MinPrice?.ToString("N0") ?? "Не указан")
                        —
                        @(Model.MaxPrice?.ToString("N0") ?? "Не указан") ₽
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Площадь:</strong>
                    <p>
                        @(Model.MinArea?.ToString("N2") ?? "Не указана")
                        —
                        @(Model.MaxArea?.ToString("N2") ?? "Не указана") м²
                    </p>
                </div>

                <div class="col-md-4">
                    <strong>Комнат:</strong>
                    <p>@(Model.RoomCount?.ToString() ?? "Любое количество")</p>
                </div>
            </div>
        </div>
    </div>

    <h3 class="mb-3">Подходящие объекты</h3>

    <p class="text-muted">
        Найдено объектов: @Model.Properties.Count
    </p>

    @if (Model.Properties.Count == 0)
    {
        <div class="alert alert-info">
            Подходящих свободных объектов пока нет.
            Попробуйте проверить другие параметры или добавить новые объекты в каталог.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var property in Model.Properties)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(property.MainPhotoPath))
                        {
                            <img src="@property.MainPhotoPath"
                                 class="card-img-top"
                                 alt="Фотография объекта"
                                 style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height: 220px;">
                                <span class="text-muted">
                                    Фотография отсутствует
                                </span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5>@property.Type.GetDisplayName()</h5>

                            <p class="text-muted mb-2">
                                @property.Address
                            </p>

                            <p class="mb-1">
                                Район: @property.District
                            </p>

                            <p class="mb-1">
                                Площадь: @property.Area м²
                            </p>

                            @if (property.RoomCount.HasValue)
                            {
                                <p class="mb-1">
                                    Комнат: @property.RoomCount
                                </p>
                            }

                            <h4 class="mt-auto mb-3">
                                @property.Price.ToString("N0") ₽
                            </h4>

                            <a asp-controller="Properties"
                               asp-action="Details"
                               asp-route-id="@property.Id"
                               target="_blank"
                               class="btn btn-outline-secondary mb-2">
                                Посмотреть объект
                            </a>

                            <form asp-action="Add" method="post">
                                <input type="hidden"
                                       name="requestId"
                                       value="@Model.RequestId" />

                                <input type="hidden"
                                       name="propertyId"
                                       value="@property.Id" />

                                <button type="submit"
                                        class="btn btn-primary w-100">
                                    Добавить в подбор
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
