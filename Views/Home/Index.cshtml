@model RealEstateAgency.ViewModels.HomeViewModel

@using RealEstateAgency.Models.Enums

@{
    ViewData["Title"] = "Главная";
}

<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <div class="hero-label">
                <span class="hero-label-line"></span>
                АГЕНТСТВО НЕДВИЖИМОСТИ
            </div>

            <h1>
                Найдите место,<br />
                которое станет <span>вашим домом</span>
            </h1>

            <p class="hero-description">
                Подберём недвижимость под ваши цели и бюджет.
                Поможем найти подходящий объект и сопроводим на каждом этапе сделки.
            </p>

            <div class="hero-actions">
                <a asp-controller="Properties"
                   asp-action="Index"
                   class="btn btn-light btn-lg">
                    Смотреть недвижимость
                    <span aria-hidden="true">→</span>
                </a>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-outline-light btn-lg">
                        Создать аккаунт
                    </a>
                }
                else if (User.IsInRole(UserRoles.Client))
                {
                    <a asp-controller="Requests"
                       asp-action="Create"
                       class="btn btn-outline-light btn-lg">
                        Оставить заявку
                    </a>
                }
                else if (User.IsInRole(UserRoles.Realtor))
                {
                    <a asp-controller="Properties"
                       asp-action="Create"
                       class="btn btn-outline-light btn-lg">
                        Добавить объект
                    </a>
                }
                else if (User.IsInRole(UserRoles.Admin))
                {
                    <a asp-controller="Admin"
                       asp-action="Properties"
                       class="btn btn-outline-light btn-lg">
                        Модерация объектов
                    </a>
                }
            </div>

            <div class="hero-note">
                <span class="hero-note-dot"></span>
                Работаем с покупкой, продажей и арендой недвижимости
            </div>
        </div>
    </div>
</section>

<section class="home-search-section">
    <div class="container">
        <div class="home-search-card">
            <div class="home-search-heading">
                <div>
                    <span class="section-label">ПОИСК НЕДВИЖИМОСТИ</span>
                    <h2>Что вы ищете?</h2>
                </div>

                <span class="home-search-icon" aria-hidden="true">⌕</span>
            </div>

            <form asp-controller="Properties"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">
                    <div class="col-md-6 col-lg-3">
                        <label for="homeDistrict" class="form-label">
                            Район
                        </label>

                        <input id="homeDistrict"
                               name="District"
                               type="text"
                               class="form-control form-control-lg"
                               placeholder="Любой район" />
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <label for="homeType" class="form-label">
                            Тип недвижимости
                        </label>

                        <select id="homeType"
                                name="Type"
                                class="form-select form-select-lg">

                            <option value="">Все типы</option>

                            @foreach (PropertyType type in Enum.GetValues<PropertyType>())
                            {
                                <option value="@((int)type)">
                                    @type.GetDisplayName()
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 col-lg-2">
                        <label for="homeMinPrice" class="form-label">
                            Цена от, ₽
                        </label>

                        <input id="homeMinPrice"
                               name="MinPrice"
                               type="number"
                               min="0"
                               step="1000"
                               class="form-control form-control-lg"
                               placeholder="От" />
                    </div>

                    <div class="col-md-6 col-lg-2">
                        <label for="homeMaxPrice" class="form-label">
                            Цена до, ₽
                        </label>

                        <input id="homeMaxPrice"
                               name="MaxPrice"
                               type="number"
                               min="0"
                               step="1000"
                               class="form-control form-control-lg"
                               placeholder="До" />
                    </div>

                    <div class="col-lg-2">
                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">
                            Найти объект
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

<section class="catalog-section" id="catalog">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="section-label">АКТУАЛЬНЫЕ ПРЕДЛОЖЕНИЯ</span>
                <h2>Последние объекты</h2>
                <p>
                    Недвижимость, опубликованная риелторами нашего агентства.
                </p>
            </div>

            <a asp-controller="Properties"
               asp-action="Index"
               class="section-link">
                Весь каталог
                <span aria-hidden="true">→</span>
            </a>
        </div>

        @if (Model.Properties.Count == 0)
        {
            <div class="empty-properties">
                <div class="empty-properties-icon">⌂</div>

                <h3>Пока нет опубликованных объектов</h3>

                <p>
                    Новые предложения появятся здесь после проверки администратором.
                </p>

                <a asp-controller="Properties"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Перейти в каталог
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var property in Model.Properties)
                {
                    <div class="col-md-6 col-lg-4">
                        <article class="home-property-card">
                            <a asp-controller="Properties"
                               asp-action="Details"
                               asp-route-id="@property.Id"
                               class="home-property-image">

                                @if (!string.IsNullOrWhiteSpace(property.MainPhotoPath))
                                {
                                    <img src="@property.MainPhotoPath"
                                         alt="@property.Type.GetDisplayName() — @property.Address"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="property-placeholder">
                                        <span>⌂</span>
                                        <small>Фотография отсутствует</small>
                                    </div>
                                }

                                <span class="property-status">
                                    @property.Status.GetDisplayName()
                                </span>
                            </a>

                            <div class="home-property-body">
                                <div class="home-property-price">
                                    @property.Price.ToString("N0") ₽
                                </div>

                                <h3>
                                    <a asp-controller="Properties"
                                       asp-action="Details"
                                       asp-route-id="@property.Id">
                                        @property.Type.GetDisplayName()
                                    </a>
                                </h3>

                                <p class="home-property-address">
                                    <span aria-hidden="true">⌖</span>
                                    @property.Address
                                </p>

                                <p class="home-property-district">
                                    @property.District
                                </p>

                                <div class="home-property-features">
                                    <span>@property.Area.ToString("N2") м²</span>

                                    @if (property.RoomCount.HasValue)
                                    {
                                        <span>@property.RoomCount комн.</span>
                                    }
                                </div>

                                <a asp-controller="Properties"
                                   asp-action="Details"
                                   asp-route-id="@property.Id"
                                   class="btn btn-outline-primary w-100 mt-3">
                                    Подробнее об объекте
                                </a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="about-section">
    <div class="container">
        <div class="about-inner">
            <div class="about-heading">
                <span class="section-label">ДОМПРОФИ</span>

                <h2>
                    Помогаем найти<br />
                    <span>своё место</span>
                </h2>
            </div>

            <div class="about-content">
                <p>
                    Мы помогаем клиентам подобрать недвижимость,
                    организуем работу с заявками и сопровождаем оформление
                    договоров. Все предложения проходят проверку перед публикацией.
                </p>

                <div class="advantages">
                    <div class="advantage-item">
                        <span class="advantage-number">01</span>
                        <div>
                            <strong>Подбор недвижимости</strong>
                            <p>Предложения с учётом пожеланий клиента.</p>
                        </div>
                    </div>

                    <div class="advantage-item">
                        <span class="advantage-number">02</span>
                        <div>
                            <strong>Проверка объектов</strong>
                            <p>Модерация объявлений перед публикацией.</p>
                        </div>
                    </div>

                    <div class="advantage-item">
                        <span class="advantage-number">03</span>
                        <div>
                            <strong>Сопровождение сделки</strong>
                            <p>Работа с заявками и оформление договоров.</p>
                        </div>
                    </div>
                </div>

                <a asp-controller="Properties"
                   asp-action="Index"
                   class="btn btn-primary mt-4">
                    Перейти в каталог
                </a>
            </div>
        </div>
    </div>
</section>

<section class="home-bottom-section">
    <div class="container">
        <div class="home-bottom-card">
            <div>
                <span class="section-label">ВАШ СЛЕДУЮЩИЙ ШАГ</span>
                <h2>Начните поиск недвижимости</h2>
                <p>
                    Посмотрите актуальные предложения или оставьте заявку,
                    чтобы риелтор помог с подбором.
                </p>
            </div>

            <div class="home-bottom-actions">
                <a asp-controller="Properties"
                   asp-action="Index"
                   class="btn btn-light">
                    Каталог недвижимости
                </a>

                @if (User.IsInRole(UserRoles.Client))
                {
                    <a asp-controller="Requests"
                       asp-action="Create"
                       class="btn btn-outline-light">
                        Оставить заявку
                    </a>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-outline-light">
                        Регистрация
                    </a>
                }
            </div>
        </div>
    </div>
</section>