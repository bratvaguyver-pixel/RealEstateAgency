@model RealEstateAgency.ViewModels.PropertyFilterViewModel

@using RealEstateAgency.Models.Enums

@{
    ViewData["Title"] = "Каталог недвижимости";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1>Каталог недвижимости</h1>
            <p class="text-muted mb-0">
                Найдите объект, который подходит именно вам.
            </p>
        </div>

        @if (User.IsInRole("Realtor"))
        {
            <a asp-action="Create" class="btn btn-primary">
                Добавить объект
            </a>
        }
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="District" class="form-label">
                            Район
                        </label>

                        <input asp-for="District"
                               class="form-control"
                               placeholder="Например, Ленинский" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Type" class="form-label">
                            Тип недвижимости
                        </label>

                        <select asp-for="Type"
                                asp-items="Html.GetEnumSelectList<PropertyType>()"
                                class="form-select">
                            <option value="">Все типы</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label">
                            Статус
                        </label>

                        <select asp-for="Status" class="form-select">
                            <option value="">Все статусы</option>
                            <option value="@((int)PropertyStatus.Available)">
                                Доступен
                            </option>
                            <option value="@((int)PropertyStatus.Reserved)">
                                Забронирован
                            </option>
                            <option value="@((int)PropertyStatus.Sold)">
                                Продан
                            </option>
                            <option value="@((int)PropertyStatus.Rented)">
                                Сдан в аренду
                            </option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="MinPrice" class="form-label">
                            Цена от
                        </label>

                        <input asp-for="MinPrice"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="MaxPrice" class="form-label">
                            Цена до
                        </label>

                        <input asp-for="MaxPrice"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="MinArea" class="form-label">
                            Площадь от, м²
                        </label>

                        <input asp-for="MinArea"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="MaxArea" class="form-label">
                            Площадь до, м²
                        </label>

                        <input asp-for="MaxArea"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control" />
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Найти
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Сбросить фильтры
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <p class="text-muted">
        Найдено объектов: @Model.Properties.Count
    </p>

    @if (Model.Properties.Count == 0)
    {
        <div class="alert alert-info">
            По заданным параметрам объекты не найдены.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var property in Model.Properties)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(property.MainPhotoPath))
                        {
                            <img src="@property.MainPhotoPath"
                                 class="card-img-top"
                                 alt="Фотография объекта"
                                 style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height: 220px;">
                                <span class="text-muted">
                                    Фотография отсутствует
                                </span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                @property.Type.GetDisplayName()
                            </h5>

                            <p class="text-muted mb-2">
                                @property.Address
                            </p>

                            <p class="mb-1">
                                Район: @property.District
                            </p>

                            <p class="mb-1">
                                Площадь: @property.Area м²
                            </p>

                            @if (property.RoomCount.HasValue)
                            {
                                <p class="mb-1">
                                    Комнат: @property.RoomCount
                                </p>
                            }

                            <p class="mb-2">
                                Статус: @property.Status.GetDisplayName()
                            </p>

                            <h4 class="mt-auto mb-3">
                                @property.Price.ToString("N0") ₽
                            </h4>

                            <a asp-action="Details"
                               asp-route-id="@property.Id"
                               class="btn btn-outline-primary">
                                Подробнее
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>