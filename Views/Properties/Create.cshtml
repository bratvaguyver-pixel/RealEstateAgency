
@model RealEstateAgency.ViewModels.PropertyCreateViewModel

@using RealEstateAgency.Models.Enums

@{
    ViewData["Title"] = "Добавление объекта";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="mb-4">Добавление объекта недвижимости</h1>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Address"
                                   class="form-label"></label>

                            <input asp-for="Address"
                                   class="form-control"
                                   placeholder="Например, ул. Ленина, д. 10" />

                            <span asp-validation-for="Address"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="District"
                                   class="form-label"></label>

                            <input asp-for="District"
                                   class="form-control"
                                   placeholder="Например, Ленинский район" />

                            <span asp-validation-for="District"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Type"
                                   class="form-label"></label>

                            <select asp-for="Type"
                                    asp-items="Html.GetEnumSelectList<PropertyType>()"
                                    class="form-select">
                                <option value="">Выберите тип недвижимости</option>
                            </select>

                            <span asp-validation-for="Type"
                                  class="text-danger"></span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Area"
                                       class="form-label"></label>

                                <input asp-for="Area"
                                       type="number"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="Area"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Price"
                                       class="form-label"></label>

                                <input asp-for="Price"
                                       type="number"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="Price"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="RoomCount"
                                       class="form-label"></label>

                                <input asp-for="RoomCount"
                                       type="number"
                                       class="form-control" />

                                <span asp-validation-for="RoomCount"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Floor"
                                       class="form-label"></label>

                                <input asp-for="Floor"
                                       type="number"
                                       class="form-control" />

                                <span asp-validation-for="Floor"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 mt-3">
                            <label asp-for="Description"
                                   class="form-label"></label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Опишите объект недвижимости"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Photos"
                                   class="form-label"></label>

                            <input asp-for="Photos"
                                   type="file"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   multiple />

                            <div class="form-text">
                                Можно загрузить до 10 фотографий.
                                Форматы JPG, JPEG, PNG и WEBP.
                                Максимальный размер одного файла — 5 МБ.
                                Первая фотография станет главной.
                            </div>

                            <span asp-validation-for="Photos"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Сохранить объект
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Отмена
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
