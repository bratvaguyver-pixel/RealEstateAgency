
@model RealEstateAgency.ViewModels.PropertyDetailsViewModel

@using RealEstateAgency.Models.Enums

@{
    ViewData["Title"] = "Информация об объекте";
}

<div class="container py-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Вернуться в каталог
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            @if (Model.PhotoPaths.Count > 0)
            {
                <div id="propertyPhotos"
                     class="carousel slide"
                     data-bs-ride="false">

                    <div class="carousel-inner rounded">
                        @for (int i = 0; i < Model.PhotoPaths.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Model.PhotoPaths[i]"
                                     class="d-block w-100"
                                     alt="Фотография объекта"
                                     style="height: 430px; object-fit: cover;" />
                            </div>
                        }
                    </div>

                    @if (Model.PhotoPaths.Count > 1)
                    {
                        <button class="carousel-control-prev"
                                type="button"
                                data-bs-target="#propertyPhotos"
                                data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                            <span class="visually-hidden">Предыдущая</span>
                        </button>

                        <button class="carousel-control-next"
                                type="button"
                                data-bs-target="#propertyPhotos"
                                data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                            <span class="visually-hidden">Следующая</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center justify-content-center"
                     style="height: 430px;">
                    <span class="text-muted">
                        Фотографии объекта отсутствуют
                    </span>
                </div>
            }
        </div>

        <div class="col-lg-5">
            <h1 class="mb-3">@Model.Type.GetDisplayName()</h1>

            <h3 class="text-primary mb-4">
                @Model.Price.ToString("N0") ₽
            </h3>

            <p>
                <strong>Адрес:</strong> @Model.Address
            </p>

            <p>
                <strong>Район:</strong> @Model.District
            </p>

            <p>
                <strong>Площадь:</strong> @Model.Area м²
            </p>

            @if (Model.RoomCount.HasValue)
            {
                <p>
                    <strong>Количество комнат:</strong> @Model.RoomCount
                </p>
            }

            @if (Model.Floor.HasValue)
            {
                <p>
                    <strong>Этаж:</strong> @Model.Floor
                </p>
            }

            <p>
                <strong>Статус:</strong> @Model.Status.GetDisplayName()
            </p>

            <p>
                <strong>Риелтор:</strong> @Model.RealtorName
            </p>

            <p>
                <strong>Дата добавления:</strong>
                @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")
            </p>
        </div>
    </div>

    <div class="mt-5">
        <h3>Описание объекта</h3>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="mt-3">
                @Model.Description
            </p>
        }
        else
        {
            <p class="text-muted mt-3">
                Описание объекта не указано.
            </p>
        }
    </div>
</div>
